// Source for docs/img/dataflow.svg, which docs/dataflow.md embeds.
// Regenerate with: dot -Tsvg docs/img/dataflow.dot -o docs/img/dataflow.svg
//
// Deliberately the MAIN PATH only — the pre-v9 walk for the norm vector index,
// the per-vector value cache and the block encodings are described in
// dataflow.md instead. A diagram that shows every branch stops being the thing
// you look at first.
//
// SYNC: ~/src/gmod/bam-js/docs/img/dataflow.dot — same palette and spine;
// ~/src/gmod/tabix-js and ~/src/gmod/cram-js share them too. Two entries of
// their legend are missing here rather than restyled, because hic has neither:
// no orange, since blocks inflate through pako in JS, and no purple, since
// there is no worker pool. The clusters are what hic adds — cram also uses one,
// but for what moves to a worker; here they are the two chains a pair runs
// concurrently, which is the shape of the read path.
digraph hicjs {
  rankdir=TB
  newrank=true
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query [label="getContactRecords(norm, r1, r2, units, binsize)" fillcolor="#ddf4ff" color="#0969da"]
  init  [label="read header + footer" fillcolor="#dafbe1" color="#1a7f37"]
  meta  [label="chromosomes, resolutions,\nmaster index" fillcolor="#fff8c5" color="#9a6700"]
  win   [label="transpose pair, binWindow"]

  subgraph cluster_norm {
    label="normalization chain"
    fontname="Helvetica" fontsize=9 fontcolor="#57606a" color="#d0d7de"
    style="rounded,dashed"
    margin=10

    nvcache [label="normVectorCache" fillcolor="#fff8c5" color="#9a6700"]
    nvidx   [label="norm vector index\nonce per file" fillcolor="#fff8c5" color="#9a6700"]
    nvhdr   [label="read vector header" fillcolor="#dafbe1" color="#1a7f37"]
    nvvals  [label="read values" fillcolor="#dafbe1" color="#1a7f37"]
  }

  subgraph cluster_blocks {
    label="block chain"
    fontname="Helvetica" fontsize=9 fontcolor="#57606a" color="#d0d7de"
    style="rounded,dashed"
    margin=10

    matcache [label="matrixCache" fillcolor="#fff8c5" color="#9a6700"]
    mathdr   [label="read matrix header" fillcolor="#dafbe1" color="#1a7f37"]
    blknums  [label="getBlockNumbers"]
    blkcache [label="blockCache" fillcolor="#fff8c5" color="#9a6700"]
    readblk  [label="read block" fillcolor="#dafbe1" color="#1a7f37"]
    unzip    [label="inflate"]
    parse    [label="parseBlockRecords"]
  }

  filter [label="filter to bin window,\ndivide by v1 × v2"]
  out    [label="ContactRecords\nbin1, bin2, counts" fillcolor="#ddf4ff" color="#0969da"]

  query -> init
  init  -> meta
  meta  -> win

  win -> nvcache  [label=" concurrent "]
  win -> matcache [label=" concurrent "]
  { rank=same; nvcache; matcache }

  nvcache -> nvidx [label=" miss "]
  nvidx   -> nvhdr
  nvhdr   -> nvvals
  nvvals  -> filter
  // A hit returns the vector, not its values, so it still asks for the slice
  // this region needs — the vector's own ±1000-value cache usually answers.
  nvcache -> nvvals [label=" hit "]

  matcache -> mathdr [label=" miss "]
  mathdr   -> blknums
  blknums  -> blkcache [label=" per block "]
  blkcache -> readblk [label=" miss, in parallel "]
  readblk  -> unzip
  unzip    -> parse
  parse    -> filter
  blkcache -> filter [label=" hit "]

  filter -> out

  subgraph cluster_legend {
    label="Legend"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="I/O" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="cached / shared" fillcolor="#fff8c5" color="#9a6700"]
    l1 -> l2 [style=invis]
  }
}
