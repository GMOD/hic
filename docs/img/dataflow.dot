// Source for docs/img/dataflow.svg, which docs/dataflow.md embeds.
// Regenerate with: dot -Tsvg docs/img/dataflow.dot -o docs/img/dataflow.svg
//
// Deliberately the MAIN PATH only — the pre-v9 walk for the norm vector index,
// the per-vector value cache and the block encodings are described in
// dataflow.md instead. A diagram that shows every branch stops being the thing
// you look at first. Each node names the cache or function doing the work;
// dataflow.md defines the `.hic` vocabulary — matrix, block, vector — above
// the diagram.
//
// SYNC: ~/src/gmod/bam-js/docs/img/dataflow.dot — same palette, legend and
// spine; ~/src/gmod/tabix-js and ~/src/gmod/cram-js share them too. hic's own
// addition is the two clusters: the normalization chain and the block chain,
// the two a region pair walks concurrently.
digraph hicjs {
  rankdir=TB
  newrank=true
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query [label="getContactRecords(norm, r1, r2, units, binsize)" fillcolor="#ddf4ff" color="#0969da"]
  init  [label="read header + master index" fillcolor="#dafbe1" color="#1a7f37"]
  win   [label="binWindow"]

  subgraph cluster_norm {
    label="normalization chain"
    labeljust="l"
    fontname="Helvetica" fontsize=9 fontcolor="#57606a" color="#d0d7de"
    style="rounded,dashed"
    margin=10

    nvcache [label="normVectorCache" fillcolor="#fff8c5" color="#9a6700"]
    nvvals  [label="getValues" fillcolor="#dafbe1" color="#1a7f37"]
  }

  subgraph cluster_blocks {
    label="block chain"
    labeljust="l"
    fontname="Helvetica" fontsize=9 fontcolor="#57606a" color="#d0d7de"
    style="rounded,dashed"
    margin=10

    matcache [label="matrixCache" fillcolor="#fff8c5" color="#9a6700"]
    blknums  [label="getBlockNumbers"]
    blkcache [label="blockCache" fillcolor="#fff8c5" color="#9a6700"]
    readblk  [label="readBlock" fillcolor="#dafbe1" color="#1a7f37"]
    unzip    [label="unzip" fillcolor="#ffd8b5" color="#bc4c00"]
    parse    [label="parseBlockRecords"]
  }

  filter [label="filter + normalize"]
  out    [label="ContactRecords" fillcolor="#ddf4ff" color="#0969da"]

  query -> init
  init  -> win

  win -> nvcache  [label=" at the same time "]
  win -> matcache [label=" at the same time "]
  { rank=same; nvcache; matcache }

  nvcache -> nvvals
  nvvals  -> filter

  matcache -> blknums
  blknums  -> blkcache [label=" for each block "]
  blkcache -> readblk [label=" miss "]
  blkcache -> filter  [label=" hit "]
  readblk  -> unzip
  unzip    -> parse
  parse    -> filter

  filter -> out

  subgraph cluster_legend {
    label="Legend"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="reads the file" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="wasm" fillcolor="#ffd8b5" color="#bc4c00"]
    l3 [label="cached, shared by every region pair" fillcolor="#fff8c5" color="#9a6700"]
    l1 -> l2 -> l3 [style=invis]
  }
}
