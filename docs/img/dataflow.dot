// Source for docs/img/dataflow.svg, which docs/dataflow.md embeds.
// Regenerate with: dot -Tsvg docs/img/dataflow.dot -o docs/img/dataflow.svg
//
// Deliberately the MAIN PATH only — the pre-v9 walk for the norm vector index,
// the per-vector value cache and the block encodings are described in
// dataflow.md instead. A diagram that shows every branch stops being the thing
// you look at first.
//
// Every label says what the step DOES first and names the code second, in the
// small grey line under it. The audience arriving at a dataflow picture is
// usually meeting `.hic` vocabulary for the first time — matrix, block, vector —
// and a spine of bare function names asks them to know the code before the
// picture can teach them anything. dataflow.md defines those three words just
// above the diagram.
//
// SYNC: ~/src/gmod/bam-js/docs/img/dataflow.dot — same palette and spine;
// ~/src/gmod/tabix-js and ~/src/gmod/cram-js share them too. Three deliberate
// divergences: the two-line labels above (the siblings label with the function
// name alone), and one legend entry missing rather than restyled: no purple,
// since there is no worker pool. The clusters are what hic adds — cram
// also uses one, but for what moves to a worker; here they are the two chains a
// pair runs concurrently, which is the shape of the read path.
digraph hicjs {
  rankdir=TB
  newrank=true
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query [label=<ask for the contacts between two regions<br/><font point-size="8" color="#57606a">getContactRecords(norm, r1, r2, units, binsize)</font>>
         fillcolor="#ddf4ff" color="#0969da"]
  init  [label=<read the header and footer<br/><font point-size="8" color="#57606a">once per file</font>>
         fillcolor="#dafbe1" color="#1a7f37"]
  meta  [label=<chromosomes, zoom levels,<br/>where each matrix sits in the file<br/><font point-size="8" color="#57606a">master index</font>>
         fillcolor="#fff8c5" color="#9a6700"]
  win   [label=<put the pair in file order,<br/>turn base pairs into bin numbers<br/><font point-size="8" color="#57606a">binWindow</font>>]

  subgraph cluster_norm {
    label="normalization chain — how to scale a count"
    labeljust="l"
    fontname="Helvetica" fontsize=9 fontcolor="#57606a" color="#d0d7de"
    style="rounded,dashed"
    margin=10

    nvcache [label=<normalization cache<br/><font point-size="8" color="#57606a">normVectorCache</font>>
             fillcolor="#fff8c5" color="#9a6700"]
    nvidx   [label=<where every vector sits in the file<br/><font point-size="8" color="#57606a">norm vector index, once per file</font>>
             fillcolor="#fff8c5" color="#9a6700"]
    nvhdr   [label=<read the vector's header<br/><font point-size="8" color="#57606a">how many values it holds</font>>
             fillcolor="#dafbe1" color="#1a7f37"]
    nvvals  [label=<read one value per bin,<br/>for this region only<br/><font point-size="8" color="#57606a">getValues</font>>
             fillcolor="#dafbe1" color="#1a7f37"]
  }

  subgraph cluster_blocks {
    label="block chain — where the counts live"
    labeljust="l"
    fontname="Helvetica" fontsize=9 fontcolor="#57606a" color="#d0d7de"
    style="rounded,dashed"
    margin=10

    matcache [label=<matrix cache<br/><font point-size="8" color="#57606a">matrixCache</font>>
              fillcolor="#fff8c5" color="#9a6700"]
    mathdr   [label=<read this chromosome pair's<br/>list of blocks<br/><font point-size="8" color="#57606a">matrix header, one per zoom level</font>>
              fillcolor="#dafbe1" color="#1a7f37"]
    blknums  [label=<which blocks cover the window?<br/><font point-size="8" color="#57606a">getBlockNumbers</font>>]
    blkcache [label=<block cache<br/><font point-size="8" color="#57606a">blockCache</font>>
              fillcolor="#fff8c5" color="#9a6700"]
    readblk  [label=<read the block's bytes<br/><font point-size="8" color="#57606a">readBlock</font>>
              fillcolor="#dafbe1" color="#1a7f37"]
    unzip    [label=<decompress<br/><font point-size="8" color="#57606a">@gmod/inflate</font>>
              fillcolor="#ffd8b5" color="#bc4c00"]
    parse    [label=<decode it into bin, bin, count<br/><font point-size="8" color="#57606a">parseBlockRecords</font>>]
  }

  filter [label=<keep the contacts inside the window,<br/>scale each by its two bins' values>]
  out    [label=<contacts: bin1, bin2, count<br/><font point-size="8" color="#57606a">ContactRecords</font>>
          fillcolor="#ddf4ff" color="#0969da"]

  query -> init
  init  -> meta
  meta  -> win

  win -> nvcache  [label=" at the same time "]
  win -> matcache [label=" at the same time "]
  { rank=same; nvcache; matcache }

  nvcache -> nvidx [label=" not cached "]
  nvidx   -> nvhdr
  nvhdr   -> nvvals
  nvvals  -> filter
  // A hit returns the vector, not its values, so it still asks for the slice
  // this region needs — the vector's own ±1000-value cache usually answers.
  nvcache -> nvvals [label=" cached "]

  matcache -> mathdr [label=" not cached "]
  mathdr   -> blknums
  blknums  -> blkcache [label=" for each block "]
  blkcache -> readblk [label=" not cached, all at once "]
  readblk  -> unzip
  unzip    -> parse
  parse    -> filter
  blkcache -> filter [label=" cached "]

  filter -> out

  subgraph cluster_legend {
    label="Legend"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="reads the file" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="wasm" fillcolor="#ffd8b5" color="#bc4c00"]
    l3 [label="cached, shared by every region pair" fillcolor="#fff8c5" color="#9a6700"]
    l1 -> l2 -> l3 [style=invis]
  }
}
